# ---- Admin panel password ----
# Set this to any secret string. The /admin panel will ask for it before
# it lets anyone create or delete campaigns.
ADMIN_PASSWORD=change-me-please

# ---- Vercel Blob storage ----
# Auto-provisioned when you connect a Blob store to the project in the Vercel
# dashboard (Storage -> Create Database -> Blob -> Connect Project).
# You normally do NOT need to paste this manually on Vercel.
# For LOCAL development, copy the token from the Vercel dashboard here.
BLOB_READ_WRITE_TOKEN=
